@page
@model IndexModel
@using System.Globalization

@{
    ViewData["Title"] = "Produtos";
}

<div class="text-center">
    <h1 class="display-4">Loja TP108</h1>
    <p>Conheça nossos produtos.</p>
</div>

<table class="table table-striped table-bordered">
    <thead>
    <tr>
        <th>Produto</th>
        <th>Preço</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var produto in Model.Produtos)
    {
        <tr>
            <td>@produto.Nome</td>
            <td>@produto.Preco.ToString("C", CultureInfo.GetCultureInfo("pt-BR"))</td>
        </tr>
    }
    </tbody>
</table>