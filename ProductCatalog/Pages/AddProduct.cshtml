@page
@model ProductCatalog.Pages.AddProductModel

@{
    ViewData["Title"] = "Adicionar Produto";
}

<h1>Adicionar Produto</h1>

<form method="post">
    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Preco" class="form-label">Preço</label>
        <input asp-for="Preco" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Adicionar</button>
</form>

@if (Model.ProdutoAdicionado)
{
    <hr />

    <h2>Produto informado</h2>

    <p><strong>Nome:</strong> @Model.Nome</p>
    <p><strong>Preço:</strong> @Model.Preco.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</p>
}